// ===================================================================
// ТАБЛИЦА ОПКОДОВ И СПЕЦИФИКАЦИЯ СИНТАКСИЧЕСКОГО ДЕРЕВА (AST)
// Инструкции для кодогенератора компилятора под ядро CtOs
// ===================================================================

[БЛОК 1: СТРУКТУРА УЗЛОВ АБСТРАКТНОГО ДЕРЕВА (AST NODE TYPES)]
*   ProgramNode      -> Корневой узел. Содержит список глобальных директив и узлов функций.
*   DirectiveNode    -> Системный тег (#core, #target). Задает режим компиляции.
*   ImportNode       -> Узел статической линковки. Регистрирует адреса внешних модулей.
*   VariableDeclNode -> Узел объявления ячейки memory.ctos (set static).
*   FunctionNode     -> Блок кода функции. Хранит массив внутренних инструкций.
*   CommandNode      -> Узел вызова макроса (LITE_CLI_MACROS) и его текстового указателя.
*   SysCallNode      -> Прямой вызов прерывания по NID-адресу (sys_call).

[БЛОК 2: ТАБЛИЦА ОПКОДОВ ДЛЯ ВИРТУАЛЬНОЙ МАШИНЫ (VOID_WIN.EXE / VOID.RUN)]
Каждая инструкция компилируется в строгое шестнадцатеричное число (байт-код):

// Системный слой и управление потоком
0x00 -> OP_NOP       // Пустая инструкция (пропуск такта)
0x01 -> OP_INIT      // Инициализация вектора прерываний Early Boot логов
0x02 -> OP_IMPORT    // Статическая линковка модуля (&- import)
0x03 -> OP_CALL      // Переход по адресу функции (Вызов контекста)
0x04 -> OP_RET       // Возврат из функции
0x05 -> OP_TERM      // Завершение контекста с занулением локальной памяти (terminate)

// Слой выделения ячеек памяти (memory.ctos)
0x10 -> OP_ALLOC_ST  // Выделение фиксированной статической ячейки (set static)
0x11 -> OP_STORE     // Запись значения или адреса указателя в ячейку (ASSIGN '=')
0x12 -> OP_LOAD      // Чтение содержимого из cell:raw ячейки
0x13 -> OP_SYSCALL   // Вызов аппаратного прерывания шины bridge.ctos по NID

// Слой облегченных системных макросов (Lite CLI)
0x20 -> OP_NET_ALL   // Вызов сетевой диагностики (net_all)
0x21 -> OP_NET_UP    // Принудительный подъем интерфейса (net_up)
0x22 -> OP_NET_DOWN  // Сброс сетевого подключения (net_down)
0x23 -> OP_NET_FLUSH // Принудительный сброс кэша DNS (net_flush)
0x24 -> OP_NET_ARP   // Вывод ARP таблицы соседей (net_arp)
0x25 -> OP_PING      // Запуск бесконечного эхо-запроса (go)
0x26 -> OP_TRACERT   // Трассировка маршрута пакетов (trace)

// Слой пакетного менеджера (pinup)
0x30 -> OP_PIN_INST  // Аппаратная установка пакета (pinup_install)
0x31 -> OP_PIN_DL    // Асинхронное скачивание бинарника (pinup_download)
0x32 -> OP_PIN_WEB   // Отрисовка графического списка приложений (pinup_web)
0x33 -> OP_PIN_DIR   // Вывод изолированной директории песочницы (pinup_dir)
0x34 -> OP_PIN_LIT   // Проверка криптографического ключа автора (pinup_lit)
0x35 -> OP_PIN_FIN   // Финализация и очистка ОЗУ установщика (pinup_fin)

// Слой мультимедиа драйвера (CtMusic)
0x40 -> OP_MS_FIND   // Поиск паспорта трека в базе YouTube Music (music_find)
0x41 -> OP_MS_GET    // Перенаправление потока в аллокатор аудио (music_get)
